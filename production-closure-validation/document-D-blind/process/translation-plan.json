    "child_ids": [],
    "role": ""
  },
  {
    "id": "p3_txt_3",
    "source_text": "Ⅴ．課題と対策",
    "source_language": "ja",
    "target_language": "vi",
    "content_type": "body",
    "context": "Page 3 PARAGRAPH",
    "location": {
      "page": 3,
      "bbox": [
        72.0,
        197.0,
        156.0,
        211.39999389648438
      ]
    },
    "protected_tokens": [],
    "translated_text": "",
