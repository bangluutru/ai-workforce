    "parent_id": null,
    "child_ids": [],
    "role": ""
  },
  {
    "id": "p2_txt_5",
    "source_text": "Ⅲ．研修実績",
    "source_language": "ja",
    "target_language": "vi",
    "content_type": "body",
    "context": "Page 2 PARAGRAPH",
    "location": {
