  {
    "id": "p2_txt_0",
    "source_text": "Ⅱ．四半期別実績",
    "source_language": "ja",
    "target_language": "vi",
    "content_type": "header",
    "context": "Page 2 HEADER",
    "location": {
      "page": 2,
      "bbox": [
        72.0,
