#!/bin/sh
# ============================================================
# Git post-merge hook — Tự chạy auto-setup sau mỗi git pull
# ============================================================
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$HOOK_DIR/../.." && pwd)"

if [ -f "$PROJECT_DIR/scripts/auto-setup.sh" ]; then
    bash "$PROJECT_DIR/scripts/auto-setup.sh" --quiet
fi
