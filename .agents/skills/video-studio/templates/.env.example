# ==========================================================
# AI WORKFORCE - VIDEO STUDIO CONFIGURATION TEMPLATE
# ==========================================================
# Copy this file to .env in workspace root and fill your keys:
# cp .agents/skills/video-studio/templates/.env.example .env

# Free Tier Stock APIs (Free registration, high quality)
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# Freesound (Optional for Ambient / SFX): https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# Premium Tier Providers (Optional for studio quality, --tier premium)
PREMIUM_STOCK_API_KEY=
ELEVENLABS_API_KEY=
